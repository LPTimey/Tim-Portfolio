{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "baseUrl": "./public",
        "paths": {
            "three": [
                "./vendor/three.js/three.js r176/build/three.module.js"
            ],
            "three/addons/*": [
                "./vendor/three.js/three.js r176/examples/jsm/*"
            ],
            "three/fonts/*": [
                "./vendor/three.js/three.js r176/examples/fonts/*"
            ]
        },
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs"
    ],
    "exclude": [
        "**/node_modules/*",
        "**/vendor/*",
        "**/dist/*",
        "**/doc/*",
        "**/src/*",
        "**/target/*",
        "**/.git/*"
    ]
}