{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projekte Schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommended": {
            "type": "boolean",
            "description": "Optionales Feld zur Markierung als empfohlenes Projekt"
          },
          "title": {
            "type": "string"
          },
          "superTitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "href": {
            "type": "string"
          },
          "imgPaths": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "light": { "type": "string" },
                  "dark": { "type": "string" }
                },
                "required": ["light", "dark"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "title",
          "recommended",
          "superTitle",
          "categories",
          "description",
          "href",
          "imgPaths"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["data"],
  "additionalProperties": false
}
