CompileFlags:
    Add: [-std=gnu++20, -pedantic, -Wall, -Wextra, -Wcast-align, -Wcast-qual, -Wctor-dtor-privacy, -Wdisabled-optimization, -Wformat=2, -Winit-self, -Wlogical-op, -Wmissing-declarations, -Wmissing-include-dirs, -Wnoexcept, -Wold-style-cast, -Woverloaded-virtual, -Wredundant-decls, -Wsign-conversion, -Wsign-promo, -Wstrict-null-sentinel, -Wstrict-overflow=5, -Wswitch-default, -Wundef, -Wno-unused]
    Compiler: clang++