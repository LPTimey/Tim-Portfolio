{
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: clang++ build POSIX",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "clang++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/out/main"
            ]
        },
        {
            "type": "process",
            "label": "C/C++: clang++ build Win",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "clang++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++23",
                "${workspaceFolder}\\src\\main.cpp",
                "-o",
                "${workspaceFolder}\\out\\main.exe"
            ]
        }
    ],
    "version": "2.0.0"
}