744 0 obj
  << /ActualText (Drucker sind ber\374chtigt f\374r frustrierende Bedienung\056 Veraltete Benutzeroberfl\344chen\054 verschachtelte Men\374s und unklare Abl\344ufe sorgen oft daf\374r\054 dass sie nicht so funktionieren\054 wie es Nutzer erwarten\056 Im Rahmen eines Studienprojekts habe ich das veraltete\054 wenig benutzerfreundliche UI der hochschuleigenen Drucker neu gestaltet\056 Das Redesign optimiert insbesondere die Touch\055Bedienung durch gr\366\337ere Buttons\054 )
     /K [ 13 ]
     /P 745 0 R
     /Pg 718 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

